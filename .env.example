# Norma Traffic Monitor - Environment Configuration
# Copy this file to .env and fill in your actual values

# Slack webhook URL for alerts
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Override config.yaml settings with environment variables
# NGINX_ACCESS_LOG=/var/log/nginx/hng-access.log
# AUDIT_LOG=/var/log/detector/audit.log
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080
